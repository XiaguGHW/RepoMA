# Copy this file to ".env" in the repoMA root, then replace every placeholder.
# Do not upload your real .env file: it contains your Bosch credentials and local paths.

# Bosch Model Farm authentication
BOSCH_FARM_SUBSCRIPTION_KEY=PASTE_YOUR_BOSCH_FARM_SUBSCRIPTION_KEY_HERE
BOSCH_FARM_BASE_URL=https://PASTE_YOUR_BOSCH_FARM_BASE_URL_HERE

# Absolute path to the folder that contains ALL BG folders.
# Example:
# BG_DATA_ROOT=C:\Users\NUL4FE\OneDrive - Bosch Group\...\Datenset
BG_DATA_ROOT=C:\PASTE\YOUR\ABSOLUTE\PATH\TO\Datenset
